.DS_Store
**/__pycache__/
**/*.pyc
**/out/
**/out-*/
**/cache/
**/cache-*/
**/broadcast/
**/.env
**/.env.*
!**/.env.example
**/.keeper-signer/
**/.range-keeper-signer/
**/*keystore*
**/*password*
**/*.lock
!**/package-lock.json
!**/pnpm-lock.yaml
!**/yarn.lock
!**/bun.lock
frontend/node_modules/
frontend/.next/
frontend/dist/
.local/

# Documentation stays local: only READMEs and the third-party license notice are published.
*.md
!README.md
!**/README.md
!THIRD_PARTY_NOTICES.md

# Stray local terminal capture
/ran

# Phase 0 research outputs (generated locally; only the code and tests are published)
ramses-vaults/research/dual-range-backtest/results/
ramses-vaults/research/dual-range-backtest/__pycache__/

# release archives are built locally by make_release.py and published (if at all) as release assets
ramses-vaults/research/dual-range-backtest/release/
**/.ramses-keeper-signer/
**/.ramses-deployer/
**/.orders-deployer/
**/.range-deployer/
